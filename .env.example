# Synaera-SA runs fully without any of these.
#
# Sign recognition, the blue mannequin, speech-to-text and text-to-speech all
# run on-device in the browser. No API key is needed to use the app.

# Optional. Enables two extras: richer English -> SASL gloss parsing, and an AI
# second opinion on signs outside the built-in vocabulary. Without it the app
# uses its own rule-based parser and on-device recogniser, and reports honestly
# when it cannot read a sign rather than guessing.
# GEMINI_API_KEY=""

# Optional. Overrides the model used for the AI assist above.
# GEMINI_MODEL="gemini-2.5-flash"
